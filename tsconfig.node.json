{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"],
  "exclude": ["src/main/**/*", "src/preload/**/*"],
  "references": [
    {
      "path": "./tsconfig.web.json"
    }
  ]
}
