{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AU Launcher",
  "version": "1.6.0",
  "identifier": "com.au.launcher",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AU Launcher",
        "width": 1000,
        "height": 760,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/GeoLite2-Country.mmdb",
      "resources/7zip/7za.exe",
      "resources/7zip/License.txt"
    ],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
